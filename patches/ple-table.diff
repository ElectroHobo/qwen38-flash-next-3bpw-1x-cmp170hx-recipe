+# Recipe change: one host copy of the table for several servers. With
+# VLLM_QWEN_PLE_SHARED_DIR (a host tmpfs directory mounted at the same path in every
+# container) and VLLM_QWEN_PLE_SHARED_NAME (names the table), the pinned table is a
+# shared mapping of <dir>/<key>.<layer>.<dim>.<dtype>.bin in global row order,
+# registered with CUDA instead of allocated; each ETP rank maps its own row range,
+# so one-card and two-card servers of the same table share it. Loading fills only
+# empty rows and compares filled ones byte for byte, under a file lock, so a server
+# with a different table stops at load instead of changing another server's rows.
+_PLE_SHARED_DIR = os.environ.get("VLLM_QWEN_PLE_SHARED_DIR", "")
+_PLE_SHARED_NAME = os.environ.get("VLLM_QWEN_PLE_SHARED_NAME", "")
+
+
 class Qwen4ExpPLEPinnedHostEmbedding(Qwen4ExpPLEEmbedding):
     """PLE table loaded into pinned CPU memory and looked up through UVA."""
 
