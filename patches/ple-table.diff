+    def _map_shared_weight(
+        self,
+        num_embeddings: int,
+        embedding_dim: int,
+        dtype: torch.dtype,
+    ) -> torch.Tensor:
+        start = self.shard_indices.org_vocab_start_index
+        if self.shard_indices.added_vocab_end_index != self.shard_indices.added_vocab_start_index:
+            raise ValueError("shared PLE table: added vocabulary is not supported")
+        itemsize = torch.empty(0, dtype=dtype).element_size()
+        row_bytes = embedding_dim * itemsize
+        layer = self.prefix.replace("/", "_") if getattr(self, "prefix", "") else "ple"
+        name = f"{_PLE_SHARED_NAME}.{layer}.{embedding_dim}.{str(dtype).split('.')[-1]}.bin"
+        path = os.path.join(_PLE_SHARED_DIR, name)
+        begin, end = start * row_bytes, (start + num_embeddings) * row_bytes
+        with open(path + ".lock", "a+") as lock:
+            fcntl.flock(lock, fcntl.LOCK_EX)
+            fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
+            try:
+                if os.fstat(fd).st_size < end:
+                    os.ftruncate(fd, end)
+                lead = begin % mmap.ALLOCATIONGRANULARITY
+                self._shared_mmap = mmap.mmap(fd, end - begin + lead, offset=begin - lead)
+            finally:
+                os.close(fd)
+        raw = torch.frombuffer(self._shared_mmap, dtype=torch.uint8)
+        rc = torch.cuda.cudart().cudaHostRegister(raw.data_ptr(), raw.numel(), 0)
+        if rc != torch.cuda.cudart().cudaError.success:
+            raise RuntimeError(f"shared PLE table: cudaHostRegister failed ({rc}) for {path}")
+        self._shared_path = path
+        logger.info("PLE table rows %d-%d mapped from shared %s (%.2f GiB, registered)",
+                    start, start + num_embeddings, path, (end - begin) / 2**30)
+        return raw[lead:].view(num_embeddings, row_bytes).view(dtype).view(
+            num_embeddings, embedding_dim)
+
